{
  "name": "@locli/cli",
  "version": "0.1.6",
  "description": "Put your app's user-facing texts into locli: push new texts, pull approved releases. Agent-first, any stack (iOS String Catalogs, Android XML, web/backend JSON), with an MCP server.",
  "mcpName": "io.github.mariohahn/locli",
  "type": "module",
  "bin": {
    "locli": "bin/locli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./schema/locli.json": "./schema/locli.json"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "skill/",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "localization",
    "i18n",
    "translations",
    "xcstrings",
    "android",
    "icu",
    "mcp",
    "agents"
  ],
  "homepage": "https://locli.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariohahn/locli.git"
  },
  "bugs": "https://github.com/mariohahn/locli/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
